generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = "DATABASE_URL"
}

model users {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  age      Int
  email    String
  name     String
  password String
  phone    String
}
